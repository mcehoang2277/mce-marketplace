{
  "version": 2,
  "name": "mce-marketplace",
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/manifest.json$",
      "headers": {
        "Content-Type": "application/manifest+json"
      },
      "dest": "/manifest.json"
    },
    {
      "src": "^/sw.js$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Content-Type": "application/javascript"
      },
      "dest": "/sw.js"
    },
    {
      "src": "^/mobile$",
      "dest": "/mobile.html"
    },
    {
      "src": "^/auth$",
      "dest": "/auth.html"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    }
  ]
}