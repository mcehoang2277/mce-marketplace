{
  "version": 2,
  "name": "mce-marketplace",
  "builds": [
    { "src": "mobile.html", "use": "@vercel/static" },
    { "src": "auth.html", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/sw.js", "dest": "/sw.js" },
    { "src": "/auth", "dest": "/auth.html" },
    { "src": "/auth.html", "dest": "/auth.html" },
    { "src": "/mobile", "dest": "/mobile.html" },
    { "src": "/mobile.html", "dest": "/mobile.html" },
    { "src": "/(.*)", "dest": "/mobile.html" }
  ]
}
