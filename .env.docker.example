# Copy this file to .env for Docker Compose local/staging use.
# Replace every placeholder with unique random values. Never commit the resulting .env.
NODE_ENV=production
POSTGRES_DB=mce_marketplace
POSTGRES_USER=mce_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://mce_app:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/mce_marketplace?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SEPAY_WEBHOOK_SECRET=
VIETQR_BANK_CODE=MB
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
CORS_ORIGINS=https://your-web-domain.example
# Only required if you explicitly enable the optional Redis profile.
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_REDIS_PASSWORD
