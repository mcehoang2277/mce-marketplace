# Copy to .env locally. Never commit this file or real credentials.
NODE_ENV=development
PORT=8000
APP_NAME="MCE Marketplace Core"
API_PREFIX=/api

# PostgreSQL. For Docker Compose, use host "postgres" in DATABASE_URL.
DATABASE_URL=
POSTGRES_DB=mce_marketplace
POSTGRES_USER=mce_app
POSTGRES_PASSWORD=
# Generate at least 32 random bytes; do not reuse a sample/default secret.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Payment integration. Keep live values only in protected hosting secrets.
VIETQR_BANK_CODE=MB
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=

# Required only when deliberately running prisma/seed.ts against a reviewed database.
ADMIN_PHONE=
ADMIN_FULL_NAME=
ADMIN_PASSWORD=
ADMIN_BOOTSTRAP_CONFIRM=

# CORS: comma-separated exact origins. Use production web origins only in production.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Geofence & dispatch
MAX_DISPATCH_RADIUS_KM=6
GEOFENCE_RADIUS_METERS=150
GPS_MAX_ALLOWED_ACCURACY_METERS=50
GOOGLE_MAPS_API_KEY=

# Optional Redis profile. The API currently does not consume Redis.
REDIS_PASSWORD=
