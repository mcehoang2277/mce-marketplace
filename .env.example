# Environment variables template for MCE Marketplace
NODE_ENV=development
PORT=8000
APP_NAME="MCE Marketplace Core"
API_PREFIX=/api/v1

# PostgreSQL Database Connection
DATABASE_URL="postgresql://mce_admin:mce_secure_password_2026@localhost:5432/mce_marketplace?schema=public"

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=mce_redis_secret_2026

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_string_in_production_at_least_32_bytes
JWT_EXPIRES_IN=7d

# VietQR / Open Banking Configuration
VIETQR_BANK_CODE=MB
VIETQR_ACCOUNT_NO=0988888888
VIETQR_ACCOUNT_NAME="MCE VIETNAM ESCROW"
WEBHOOK_HMAC_SECRET=replace_with_webhook_signature_secret

# Geofence & Dispatch Constants
MAX_DISPATCH_RADIUS_KM=6.0
GEOFENCE_RADIUS_METERS=150
GPS_MAX_ALLOWED_ACCURACY_METERS=50
