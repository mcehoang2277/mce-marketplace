# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
PORT=8000
APP_NAME="MCE Marketplace Core"
API_PREFIX=/api

# PostgreSQL (required)
DATABASE_URL=

# JWT (required; generate at least 32 random bytes)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Payment integration (configure only in a protected environment)
VIETQR_BANK_CODE=MB
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
WEBHOOK_HMAC_SECRET=

# CORS: comma-separated exact origins; native apps usually send no Origin header.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Geofence & dispatch
MAX_DISPATCH_RADIUS_KM=6
GEOFENCE_RADIUS_METERS=150
GPS_MAX_ALLOWED_ACCURACY_METERS=50
